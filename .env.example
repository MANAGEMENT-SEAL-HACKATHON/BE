# =============================================================================
# SEAL Hackathon BE — biến môi trường (NHẠY CẢM)
# =============================================================================
# 1. Copy file này thành .env ở cùng thư mục pom.xml:
#      copy .env.example .env
# 2. Điền giá trị thật — KHÔNG commit .env (đã có trong .gitignore).
# 3. Chạy app: DotenvEnvironment nạp .env trước khi Spring Boot start.
#
# Alias (NutricanPT / template cũ)     →  Spring property
# JWT_SECRET_KEY                       →  security.jwt.secret
# JWT_EXPIRATION_MS (milliseconds)     →  security.jwt.access-ttl-minutes
# DB_PASS / DB_USER                    →  spring.datasource.*
# =============================================================================

# --- JWT (bắt buộc khi security.jwt.enabled=true) ---
JWT_SECRET_KEY=CHANGE_ME_min_32_characters_for_HS256!!
# 86400000 = 24 giờ | 1800000 = 30 phút
JWT_EXPIRATION_MS=1800000

SECURITY_JWT_ENABLED=true
# SECURITY_JWT_SECRET=   # tùy chọn nếu không dùng JWT_SECRET_KEY
SECURITY_JWT_ISSUER=seal-hackathon-api
# SECURITY_JWT_ACCESS_TTL_MINUTES=30
SECURITY_JWT_REFRESH_TTL_DAYS=7

# Tắt JWT (stub Coordinator id=1, không cần Bearer):
# SECURITY_JWT_ENABLED=false

# --- MySQL (dev local) ---
DB_USER=root
DB_PASS=your_mysql_password
# SPRING_DATASOURCE_USERNAME=
# SPRING_DATASOURCE_PASSWORD=

# --- Production DB (application-prod.properties) ---
# DB_HOST=your-server.mysql.database.azure.com
# DB_USER=
# DB_PASS=

# --- App (link email mời / login) ---
APP_FRONTEND_URL=http://localhost:5173
# Production sau: APP_FRONTEND_URL=https://seal-hackathon-fe.vercel.app

# --- Server (tùy chọn) ---
# SERVER_PORT=8080

# --- Object storage (slide PDF + ảnh thẻ SV) — MinIO riêng SEAL ---
# docker compose -f docker-compose.minio.yml up -d
# Console: http://localhost:19001 | Bucket: seal-submissions
# Data giữ trong volume Docker — không xóa container/volume thì file vẫn còn.
APP_STORAGE_TYPE=minio
APP_STORAGE_MINIO_ENDPOINT=http://localhost:19000
APP_STORAGE_MINIO_ACCESS_KEY=minioadmin
APP_STORAGE_MINIO_SECRET_KEY=minioadmin
APP_STORAGE_MINIO_BUCKET=seal-submissions

# --- GitHub API (FR-17 metadata + commits, read-only PAT) ---
# Dotenv maps GITHUB_API_TOKEN → app.github.token
APP_GITHUB_ENABLED=false
GITHUB_API_TOKEN=
# APP_GITHUB_TOKEN=
# APP_GITHUB_API_BASE_URL=https://api.github.com
# APP_GITHUB_COMMIT_LIMIT=30
# APP_GITHUB_CACHE_TTL_SECONDS=300
